# systemd-Unit für den Betrieb OHNE Docker (siehe docs/DEPLOYMENT.md)
[Unit]
Description=Uber Alkhaled – Preis-Worker
After=network-online.target postgresql.service

[Service]
Type=simple
User=uberpreis
WorkingDirectory=/opt/uber-alkhaled
EnvironmentFile=/opt/uber-alkhaled/.env
ExecStart=/usr/bin/node --import tsx src/worker/index.ts
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
