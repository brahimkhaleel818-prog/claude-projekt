{
  "name": "uber-preismonitor",
  "version": "1.0.0",
  "private": true,
  "description": "Uber Live Price Monitor – Düsseldorf",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "worker": "node --import tsx src/worker/index.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "probe:uber": "tsx scripts/probe-uber.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "vapid": "tsx scripts/generate-vapid.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vercel-build": "prisma generate && sh scripts/migrate-deploy.sh && tsx prisma/seed.ts && next build"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "jose": "6.1.0",
    "lucide-react": "0.544.0",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "pino": "9.11.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "2.15.4",
    "tailwind-merge": "3.3.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/web-push": "3.6.4",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "22.x"
  }
}