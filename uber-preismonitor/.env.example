# ─── Datenbank ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://monitor:monitor@localhost:5432/uber_monitor?schema=public"

# ─── Login (Dashboard & API) ────────────────────────────────────────────────
ADMIN_USERNAME="admin"
# bcrypt-Hash erzeugen:  npm run hash-password -- "MeinSicheresPasswort"
ADMIN_PASSWORD_HASH=""
# Alternative ohne Hash (z. B. Vercel): Klartext-Passwort, mind. 12 Zeichen. Hash ist sicherer.
ADMIN_PASSWORD=""
# Mind. 32 zufällige Zeichen, z. B.:  openssl rand -base64 48
AUTH_SECRET=""
# Nur bei HTTPS auf "true" lassen (Cookies mit Secure-Flag)
COOKIE_SECURE="true"
# Optional: Token für Maschinen-Zugriff auf die API (Header: Authorization: Bearer <token>)
API_TOKEN=""

# Nur für Vercel/Serverless: Geheimnis für den Cron-Endpunkt /api/cron/collect
# (z. B. openssl rand -hex 32). Der Aufrufer sendet "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# ─── Preis-Datenquelle ──────────────────────────────────────────────────────
# none             = keine Quelle (Preise "Nicht verfügbar")
# uber-guest-rides = Uber for Business – Guest Rides API (empfohlen, Freigabe nötig)
# uber-riders-v12  = Uber Riders API v1.2 /estimates/price (Freigabe nötig)
# demo             = SIMULIERTE Daten für Entwicklung/Test (immer als DEMO markiert)
PRICE_PROVIDER="none"

# Uber Guest Rides (Uber for Business)
UBER_CLIENT_ID=""
UBER_CLIENT_SECRET=""
UBER_ORGANIZATION_UUID=""          # optional, Header x-uber-organizationuuid
UBER_SCOPE="guests.trips"
UBER_API_BASE="https://api.uber.com"
UBER_AUTH_URL="https://auth.uber.com/oauth/v2/token"
UBER_SANDBOX_RUN_UUID=""           # nur für die Sandbox
UBER_ACCEPT_LANGUAGE="de"

# Uber Riders API v1.2 (Server-Token, nur mit Freigabe von Uber)
UBER_SERVER_TOKEN=""

# true = nur Upfront-Festpreise (wie in der App) speichern, Preisspannen verwerfen
ONLY_UPFRONT_FARES="false"

# Limits der Datenquelle (an Vertrag/Freigabe von Uber anpassen!)
PROVIDER_MAX_REQUESTS_PER_MINUTE="20"
PROVIDER_MAX_REQUESTS_PER_HOUR="600"
PROVIDER_MIN_INTERVAL_MINUTES="1"

# ─── Worker ─────────────────────────────────────────────────────────────────
WORKER_POLL_SECONDS="10"
WORKER_CONCURRENCY="2"
WORKER_MAX_RETRIES="3"
LOG_LEVEL="info"

# ─── Geocoding (OpenStreetMap Nominatim) ────────────────────────────────────
NOMINATIM_URL="https://nominatim.openstreetmap.org"
# Nominatim verlangt eine identifizierende Kontaktangabe (E-Mail oder URL)
NOMINATIM_CONTACT=""

# ─── Benachrichtigungen ─────────────────────────────────────────────────────
# Browser-Push (VAPID). Schlüssel erzeugen:  npm run vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Telegram (optional): Bot über @BotFather anlegen, Chat-ID ermitteln
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# E-Mail (optional, SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
ALERT_EMAIL_TO=""

# Öffentliche URL der App (für Links in Benachrichtigungen)
APP_URL="http://localhost:3000"
