ber_size":40,"number_border_radius":10,"number_padding":12,"line_color":"#ffffff","line_width":2}},"faq_ast":{"type":"faq-accordion-4","blocks":{"faq_1":{"type":"faq_item","settings":{"question":"Hoe lang duurt het voordat ik resultaten zie?","answer":"<p>De meeste klanten merken verbeteringen binnen 3-4 weken. Volledige voordelen pieken rond week 6-8. Astaxanthine bouwt zich op in uw lichaam, dus hoe langer u het consistent neemt, hoe beter de resultaten.*</p>"}},"faq_2":{"type":"faq_item","settings":{"question":"Is het veilig voor langdurig gebruik?","answer":"<p>Ja. Astaxanthine is uitgebreid onderzocht met decennia aan onderzoek en geen bijwerkingen bij standaarddoseringen. Ons product is Non-GMO, door derden getest en GMP-gecertificeerd.*</p>"}},"faq_3":{"type":"faq_item","settings":{"question":"Kan ik het samen met andere supplementen nemen?","answer":"<p>Ja, astaxanthine werkt synergistisch met de meeste supplementen. Raadpleeg uw arts als u bloedverdunners of immunosuppressiva gebruikt.*</p>"}},"faq_4":{"type":"faq_item","settings":{"question":"Waarom 4 softgels per dag in plaats van minder?","answer":"<p>Astaxanthine is vetoplosbaar — uw lichaam absorbeert beperkte hoeveelheden tegelijk. Door 2x per dag te nemen (2 's ochtends, 2 's avonds) maximaliseert u de opname gedurende de hele dag.*</p>"}},"faq_5":{"type":"faq_item","settings":{"question":"Hoe verschilt dit van andere antioxidanten?","answer":"<p>De meeste antioxidanten zijn alleen wateroplosbaar. Astaxanthine is zowel water- als vetoplosbaar, waardoor het zich over het gehele celmembraan verankert en elke cel beschermt. Het is 6.000x krachtiger dan Vitamine C en 800x sterker dan CoQ10.</p>"}},"faq_6":{"type":"faq_item","settings":{"question":"Wat als het niet voor mij werkt?","answer":"<p>Wij bieden een 90-dagen niet-goed-geld-terug-garantie. Als u niet 100% tevreden bent, betalen wij elke cent terug — zonder vragen, zonder formulieren, zonder gedoe.</p>"}},"faq_7":{"type":"faq_item","settings":{"question":"Hoe bewaar ik het product?","answer":"<p>Bewaar op een koele, droge plaats uit direct zonlicht. Koeling is niet nodig. Houd de dop stevig gesloten na gebruik.</p>"}},"faq_8":{"type":"faq_item","settings":{"question":"Hoe snel wordt mijn bestelling verzonden?","answer":"<p>Snelle, getraceerde verzending door heel Nederland en België. De meeste bestellingen worden binnen 3-5 werkdagen bezorgd.</p>"}},"faq_9":{"type":"faq_item","settings":{"question":"Waar wordt Eveom™ gemaakt?","answer":"<p>Eveom™ Astaxanthine wordt geproduceerd in een GMP-gecertificeerde faciliteit en per batch door derden getest. Wij geven prioriteit aan kwaliteitscontrole bij elke stap — van het inkopen van natuurlijke microalgen tot het eindproduct.</p>"}},"faq_10":{"type":"faq_item","settings":{"question":"Hoe en wanneer moet ik het innemen?","answer":"<p>Neem 2 softgels ’s ochtends en 2 ’s avonds, elk met een maaltijd die gezond vet bevat. Door uw dosis op te splitsen maximaliseert u de opname gedurende de hele dag aangezien astaxanthine vetoplosbaar is. Consistentie is belangrijker dan perfecte timing, maak het gewoon onderdeel van uw routine.</p>"}},"faq_11":{"type":"faq_item","settings":{"question":"Moet ik mijn routine veranderen?","answer":"<p>Nee! Voeg simpelweg 4 softgels per dag toe aan uw bestaande routine — 2 ’s ochtends en 2 ’s avonds. Het werkt naast wat u al doet.</p>"}},"faq_12":{"type":"faq_item","settings":{"question":"Zijn er leeftijds- of gezondheidsbeperkingen?","answer":"<p>Eveom™ is ontworpen voor volwassenen van 18 jaar en ouder. Niet aanbevolen tijdens zwangerschap of borstvoeding. Raadpleeg uw arts als u een medische aandoening heeft of medicijnen gebruikt.*</p>"}},"faq_13":{"type":"faq_item","settings":{"question":"Kan ik Eveom™ in winkels kopen?","answer":"<p>Nog niet. Wij verkopen exclusief via onze website zodat we volledige kwaliteitscontrole kunnen behouden, de beste prijzen kunnen bieden en elke bestelling kunnen ondersteunen met onze 90-dagen garantie. U zult ons nooit met een opslag bij een retailer vinden.</p>"}}},"block_order":["faq_1","faq_2","faq_3","faq_4","faq_5","faq_6","faq_7","faq_8","faq_9","faq_10","faq_11","faq_12","faq_13"],"settings":{"background_color":"#ffffff","section_padding_top_desktop":60,"section_padding_bottom_desktop":60,"section_padding_top_mobile":40,"section_padding_bottom_mobile":40,"heading_before":"Veelgestelde","highlighted_text":"Vragen","highlight_position":"inline","heading_tag":"h2","heading_text_align":"center","heading_font_size_desktop":48,"heading_font_size_mobile":32,"heading_font_weight":"500","heading_color":"#000000","heading_margin_bottom":40,"highlighted_gradient_enabled":true,"highlighted_gradient":"linear-gradient(89deg, rgba(36, 57, 24, 1) 7%, rgba(0, 0, 0, 1) 100%)","highlighted_color":"#000000","highlighted_font_size_desktop":48,"highlighted_font_size_mobile":32,"highlighted_font_weight":"700"}},"bundle_bespaar_ast":{"type":"ev-bundle-bespaar","settings":{}},"wellness_cards_ast":{"type":"ev-wellness-cards","settings":{}},"one_formula_ast":{"type":"ev-one-formula","settings":{}},"research_badges_ast":{"type":"ev-research-badges","settings":{}},"clinically_verified_ast":{"type":"ev-clinically-verified","settings":{}},"expert_tabs_ast":{"type":"ev-expert-tabs","settings":{}},"guarantee_ast":{"type":"ev-guarantee","settings":{}},"description_ast":{"type":"ev-description","settings":{}},"why_need_ast":{"type":"ev-why-need","settings":{}},"does_it_work_ast":{"type":"ev-does-it-work","settings":{}},"benefits_list_ast":{"type":"ev-benefits-list","settings":{}},"key_ingredients_ast":{"type":"ev-key-ingredients","settings":{}},"how_to_take_ast":{"type":"ev-how-to-take","settings":{}},"safety_ast":{"type":"ev-safety","settings":{}},"comparison_summary_ast":{"type":"ev-comparison-summary","settings":{}}},"order":["main","bundle_bespaar_ast","description_ast","why_need_ast","does_it_work_ast","benefits_list_ast","key_ingredients_ast","how_to_take_ast","safety_ast","hero_benefits